  <sys:String x:Key="L.Replay.Instant">Мгновенный повтор</sys:String>
  <sys:String x:Key="L.Replay.WarnGameOff">Предупреждать при запуске игры</sys:String>
  <sys:String x:Key="L.Replay.WarnGameOffHint">Напомнит, если повтор выключен</sys:String>
  <sys:String x:Key="L.Help.WarnGameOff">Показывает одно ненавязчивое уведомление, когда игра запущена, а мгновенный повтор выключен. Запись автоматически не включается.</sys:String>
  <sys:String x:Key="L.Replay.RecordingIndicator">Индикатор записи</sys:String>
  <sys:String x:Key="L.Replay.RecordingIndicatorHint">Маленький значок в выбранном углу экрана</sys:String>
  <sys:String x:Key="L.Replay.IndicatorPosition">Положение индикатора</sys:String>
  <sys:String x:Key="L.Replay.BufferLength">Длина буфера</sys:String>
