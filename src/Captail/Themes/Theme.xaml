  <Geometry x:Key="IconChevron">M6 9l6 6 6-6</Geometry>
  <Geometry x:Key="IconBack">M19 12H5 M12 19l-7-7 7-7</Geometry>
  <Geometry x:Key="IconDisplay">M2 4h20v13H2z M8 21h8 M12 17v4</Geometry>
  <Geometry x:Key="IconMic">M9 2h6v12H9z M5 10v1a7 7 0 0 0 14 0v-1 M12 18v4</Geometry>
