<Window x:Class="Captail.DisplayIdentifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Captail display identifier"
        Width="220" Height="150"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Grid>
        <Border x:Name="IdentifierCard"
                Width="194" Height="126"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F2141A1C"
                BorderBrush="#FF5BE0C0"
                BorderThickness="1"
                CornerRadius="18"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="#B0000000"
                                  BlurRadius="24"
                                  ShadowDepth="8"
                                  Opacity="0.72"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="IdentifierScale" ScaleX="0.9" ScaleY="0.9"/>
            </Border.RenderTransform>
            <Grid>
                <Border Width="42" Height="3"
                        Margin="0,13,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#FF5BE0C0"
                        CornerRadius="2"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L.Video.DisplayLabel}"
                               HorizontalAlignment="Center"
                               Foreground="#FF93A1A7"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DisplayNumberText"
                               Margin="0,-4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#FFF3F7F5"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="62"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
