<Window x:Class="Captail.ReplayStatusIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="30" Height="30"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Focusable="False">
    <Grid x:Name="IndicatorRoot" Width="28" Height="28"
          HorizontalAlignment="Center" VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <Ellipse Width="22" Height="22"
                 Fill="#FF11171A" Stroke="#FF344047" StrokeThickness="1"/>

        <Grid Width="18" Height="18">
            <Ellipse Stroke="#4A506067" StrokeThickness="1.5"/>
            <Ellipse x:Name="StateRing"
                     Stroke="#FF63E0BD" StrokeThickness="2.1"
                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                     StrokeDashArray="7 3"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="RingRotation" Angle="0"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="CenterDot" Width="4" Height="4"
                     Fill="#FF63E0BD"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Path x:Name="SavedGlyph" Visibility="Collapsed"
                  Data="M3.2 8.8 L6.7 12.1 L14.8 4.4"
                  Stroke="#FF63E0BD" StrokeThickness="2.1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Stretch="None"/>
            <Path x:Name="ErrorGlyph" Visibility="Collapsed"
                  Data="M5 5 L13 13 M13 5 L5 13"
                  Stroke="#FFFF5F63" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="None"/>
        </Grid>
    </Grid>
</Window>
