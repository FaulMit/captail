                        <Button x:Name="SaveTrimButton" Margin="8,0,0,0"
                                Content="{DynamicResource L.Library.SaveTrim}"
                                Style="{StaticResource AccentButton}" Padding="18,9"
                                Click="SaveTrim_Click"/>
                    </StackPanel>
                </Grid>

                <Popup x:Name="OutputSettingsPopup"
                       PlacementTarget="{Binding ElementName=OutputSettingsButton}"
                       Placement="Top" HorizontalOffset="-286" VerticalOffset="-8"
                       AllowsTransparency="True" StaysOpen="True"
                       PopupAnimation="None">
                    <Border Width="326" Padding="16"
                            Background="#FF151A1D"
                            BorderBrush="{StaticResource WindowBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L.Library.OutputSettings}"
                                           FontSize="14" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
