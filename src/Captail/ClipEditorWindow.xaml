                                       Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource L.Library.VideoCodec}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="VideoCodecComboBox" Grid.Column="1"
                                          Style="{StaticResource DarkCombo}"
                                          DisplayMemberPath="Label"/>
                                <TextBlock Grid.Row="1" Text="{DynamicResource L.Audio.Codec}"
                                           Margin="0,9,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="AudioCodecComboBox" Grid.Row="1" Grid.Column="1"
                                          Margin="0,9,0,0"
                                          Style="{StaticResource DarkCombo}"
                                          DisplayMemberPath="Label"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource L.Library.Resolution}"
                                           Margin="0,9,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="ResolutionComboBox" Grid.Row="2" Grid.Column="1"
                                          Margin="0,9,0,0"
                                          Style="{StaticResource DarkCombo}"
                                          DisplayMemberPath="Label"/>
                                <TextBlock Grid.Row="3" Text="{DynamicResource L.Video.Bitrate}"
                                           Margin="0,9,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <ComboBox x:Name="BitRateComboBox" Grid.Row="3" Grid.Column="1"
                                          Margin="0,9,0,0"
                                          Style="{StaticResource DarkCombo}"
                                          DisplayMemberPath="Label"/>
                            </Grid>
                            <CheckBox x:Name="MergeAudioCheckBox" Margin="0,14,0,0"
                                      Style="{StaticResource EditorMergeCheckBox}"
                                      ToolTip="{DynamicResource L.Library.MergeAudioTip}"
                                      ToolTipService.ShowOnDisabled="True">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.Library.MergeAudio}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource L.Library.MergeAudioSummary}"
                                               FontSize="9.5"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </CheckBox>
                            <Button Content="{DynamicResource L.Library.ExportAs}"
                                    Style="{StaticResource SubtleButton}"
                                    Margin="0,14,0,0" Padding="12,8"
                                    HorizontalAlignment="Stretch"
                                    Click="ExportAs_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Grid x:Name="PreviewModePanel" Grid.Row="2" Grid.RowSpan="2"
                      Margin="1,5,1,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Slider x:Name="PreviewProgressSlider"
                            Style="{StaticResource FullscreenProgressSlider}"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="PreviewProgress_MouseLeftButtonDown"
                            ValueChanged="PreviewProgress_ValueChanged"
                            Thumb.DragStarted="PreviewProgress_DragStarted"
                            Thumb.DragCompleted="PreviewProgress_DragCompleted"/>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviousReplayButton"
                                    Style="{StaticResource ClipActionButton}"
                                    Click="PreviousReplay_Click"
                                    ToolTip="{DynamicResource L.Library.PreviousReplay}">
                                <Path Data="{StaticResource IconSkipPrevious}"
                                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ClipActionButton}" Click="Back_Click"
                                    Margin="7,0,0,0"
                                    ToolTip="{DynamicResource L.Library.Back5}">
                                <Path Data="{StaticResource IconSeekBack}"
                                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="PreviewPlayButton"
                                    Style="{StaticResource ClipActionButton}"
                                    Click="PlayPause_Click" ToolTip="{DynamicResource L.Library.Play}"
                                    Margin="7,0,0,0" IsEnabled="False">
                                <Path x:Name="PreviewPlayIcon" Data="{StaticResource IconPlay}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ClipActionButton}" Click="Forward_Click"
                                    ToolTip="{DynamicResource L.Library.Forward5}" Margin="7,0,0,0">
                                <Path Data="{StaticResource IconSeekForward}"
                                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="NextReplayButton"
                                    Style="{StaticResource ClipActionButton}"
                                    Margin="7,0,0,0"
                                    Click="NextReplay_Click"
                                    ToolTip="{DynamicResource L.Library.NextReplay}">
                                <Path Data="{StaticResource IconSkipNext}"
                                      Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewPlaybackTimeText"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border x:Name="PreviewSpeedFeedback"
                                    Style="{StaticResource PlaybackSpeedFeedbackBadge}"
                                    Visibility="Collapsed" Opacity="0">
                                <TextBlock x:Name="PreviewSpeedFeedbackText"
                                           Style="{StaticResource PlayerShortcutBadgeText}"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Slider x:Name="PreviewVolumeSlider"
                                    Width="110" Margin="0,0,12,0"
                                    Minimum="0" Maximum="100" TickFrequency="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource VolumeSlider}"
                                    ToolTip="{DynamicResource L.Library.ShortcutVolume}"
                                    ValueChanged="PlayerVolumeSlider_ValueChanged"/>
                            <Button Content="{DynamicResource L.Library.Trim}"
                                    Style="{StaticResource AccentButton}" Padding="16,8"/>
                            <Button Style="{StaticResource ClipActionButton}"
                                    Margin="8,0,0,0" Click="EnterFullscreen_Click"
                                    ToolTip="{DynamicResource L.Library.Fullscreen}">
                                <Path Data="{StaticResource IconFullscreen}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,11,0,0">
                        <Grid Margin="2,0,2,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource L.Library.AudioTracks}"
                                           Style="{StaticResource SectionHeaderText}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="PreviewAudioTrackCountBadge" Margin="7,0,0,0"
                                        MinWidth="24" Height="18" Padding="6,0"
                                        Background="{DynamicResource AccentChipBgBrush}"
                                        BorderBrush="{DynamicResource AccentChipBorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="PreviewAudioTrackCountText" Text="0"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource L.Library.AudioTrackHint}"
                                       HorizontalAlignment="Right" FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                        <ScrollViewer MaxHeight="126"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <ItemsControl x:Name="PreviewAudioTrackRows"
                                          ItemsSource="{Binding AudioTracks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Tag="{Binding}" Click="AudioTrackToggle_Click"
                                                      Style="{StaticResource SourceChip}"
                                                      Height="36" Margin="0,0,8,8">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           Margin="8,0" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Codec}"
                                                           VerticalAlignment="Center" FontSize="9.5"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Grid>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="PreviewNoAudioText"
                                   Text="{DynamicResource L.Library.NoAudio}"
                                   Style="{StaticResource SecondaryText}" Margin="2,4,0,7"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Popup x:Name="PlayerHelpPopup"
                   PlacementTarget="{Binding ElementName=PlayerHelpButton}"
                   Placement="Bottom" HorizontalOffset="-270" VerticalOffset="8"
                   AllowsTransparency="True" StaysOpen="True"
                   PopupAnimation="None">
                <Border Width="620" Padding="16"
                        Background="#FF151A1D"
                        BorderBrush="{StaticResource WindowBorderBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Library.Help}"
                                   FontSize="14" FontWeight="Bold" Margin="2,0,2,10"/>
                        <Border Style="{StaticResource SettingsGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource PlayerShortcutCell}"
                                        BorderThickness="0,0,1,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutPlayback}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutPlaybackHint}"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource PlayerShortcutBadge}">
                                            <TextBlock Text="Space" Style="{StaticResource PlayerShortcutBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PlayerShortcutCell}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutSeek}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutSeekHint}"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource PlayerShortcutBadge}">
                                            <TextBlock Text="← / →" Style="{StaticResource PlayerShortcutBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource PlayerShortcutCell}"
                                        BorderThickness="0,0,1,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutSpeed}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutSpeedHint}"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource PlayerShortcutBadge}">
                                            <TextBlock Text="↓ / ↑" Style="{StaticResource PlayerShortcutBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource PlayerShortcutCell}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutVolume}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutVolumeHint}"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource PlayerShortcutBadge}">
                                            <TextBlock Text="− / +" Style="{StaticResource PlayerShortcutBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource PlayerShortcutCell}"
                                        BorderThickness="0,0,1,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Library.Fullscreen}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutFullscreenHint}"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource PlayerShortcutBadge}">
                                            <TextBlock Text="F" Style="{StaticResource PlayerShortcutBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1"
                                        Style="{StaticResource PlayerShortcutCell}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource L.Close}"
                                                       Style="{StaticResource RowLabelText}"/>
                                            <TextBlock Text="{DynamicResource L.Library.ShortcutCloseHint}"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource PlayerShortcutBadge}">
                                            <TextBlock Text="Esc" Style="{StaticResource PlayerShortcutBadgeText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <Border x:Name="RecentReplaySidebar" Grid.Row="1" Grid.Column="1"
                    Width="260" Margin="0,0,20,20" Padding="12,10"
                    Visibility="Collapsed"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1" CornerRadius="12">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="{DynamicResource L.Library.AllClips}"
                               Style="{StaticResource SectionHeaderText}"
                               Margin="2,1,2,8"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox x:Name="GameFilter" DisplayMemberPath="Label"
                                  Style="{StaticResource DarkCombo}"
                                  ToolTip="{DynamicResource L.Library.AllGames}"
                                  SelectionChanged="ReplayFilter_SelectionChanged" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RecordingModeFilter" DisplayMemberPath="Label"
                                  Style="{StaticResource DarkCombo}"
                                  ToolTip="{DynamicResource L.Library.AllModes}"
                                  SelectionChanged="ReplayFilter_SelectionChanged" Margin="0,0,0,6"/>
                        <Button Content="{DynamicResource L.Library.SelectAll}"
                                Style="{StaticResource AboutMenuButton}" Click="SelectAllReplays_Click"/>
                        <Button x:Name="DeleteSelectedReplaysButton" IsEnabled="False"
                                Style="{StaticResource AboutMenuButton}" Click="DeleteSelectedReplays_Click"/>
                        <TextBlock x:Name="ReplayLibraryStatusText" Visibility="Collapsed"
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="3,6,3,0"/>
                    </StackPanel>
                    <ListBox x:Name="RecentReplayList"
                             ItemsSource="{Binding RecentReplayItems}"
                             IsSynchronizedWithCurrentItem="False"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ReplayItemBorder" CornerRadius="7"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="ReplayItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="ReplayItemBorder" Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource AboutMenuButton}"
                                            Padding="27,7,32,7" Click="RecentReplay_Click"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="46" Height="30" CornerRadius="5"
                                                    Background="{StaticResource BgControlBrush}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Duration}"
                                                           Style="{StaticResource SecondaryText}"
                                                           FontSize="9.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <CheckBox IsChecked="{Binding IsMarked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ReplayCheckBox}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="3,0,0,0" Click="ReplayMarked_Click"
                                              ToolTip="{DynamicResource L.Library.SelectClip}"/>
                                    <Button x:Name="DeleteRecentReplayButton"
                                            Width="28" Height="28" Margin="0,0,7,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"
                                            Style="{StaticResource ClipActionButton}"
                                            ToolTip="{DynamicResource L.Library.Delete}"
                                            Click="RequestDeleteRecentReplay_Click">
                                        <Path Data="M7 8h10 M9 8V6h6v2 M9 10v8h6v-8"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                 Value="True">
                                        <Setter TargetName="DeleteRecentReplayButton"
                                                Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="OverwriteConfirmOverlay" Grid.RowSpan="2" Panel.ZIndex="30"
                    Grid.ColumnSpan="2"
                    Visibility="Collapsed" Background="#C20A0D0F"
                    CornerRadius="0">
                <Border Width="370" Padding="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Library.OverwriteTitle}"
                                   FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="OverwriteMessageText"
                                   Text="{DynamicResource L.Library.OverwriteMessage}"
                                   Margin="0,9,0,0" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverwriteFileText" Margin="0,9,0,18"
                                   Style="{StaticResource MonoText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource L.Library.Cancel}"
                                    Style="{StaticResource SubtleButton}"
                                    Margin="0,0,8,0" Click="CancelOverwrite_Click"/>
                            <Button Content="{DynamicResource L.Library.Overwrite}"
                                    Style="{StaticResource AccentButton}" Padding="16,8"
                                    Click="ConfirmOverwrite_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <Border x:Name="DeleteRecentReplayOverlay" Grid.RowSpan="2"
                    Grid.ColumnSpan="2" Panel.ZIndex="30"
                    Visibility="Collapsed" Background="#C20A0D0F"
                    CornerRadius="0">
                <Border Width="370" Padding="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Library.DeleteSelectionTitle}"
                                   FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource L.Library.DeleteSelectionMessage}"
                                   Margin="0,9,0,0" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DeleteRecentReplayFileText"
                                   Margin="0,9,0,18" Style="{StaticResource MonoText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource L.Library.Cancel}"
                                    Style="{StaticResource SubtleButton}"
                                    Margin="0,0,8,0"
                                    Click="CancelDeleteRecentReplay_Click"/>
                            <Button Content="{DynamicResource L.Library.Delete}"
                                    Style="{StaticResource AccentButton}" Padding="16,8"
                                    Click="ConfirmDeleteRecentReplay_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <Grid x:Name="SavingOverlay" Grid.RowSpan="2" Panel.ZIndex="40"
                  Visibility="Collapsed"
                  TextOptions.TextRenderingMode="Grayscale"
                  TextOptions.TextFormattingMode="Display">
                <Border x:Name="SavingBackdrop" Opacity="0"
                        Background="#DC0A0D0F"
                        CornerRadius="0"/>
                <StackPanel Width="260" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Control Style="{StaticResource LoadingIndicator}"
                             Width="36" Height="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource L.Library.SavingTitle}"
                               Margin="0,16,0,0" FontSize="15" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="SavingStatusText" Margin="0,7,0,0"
                               Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
