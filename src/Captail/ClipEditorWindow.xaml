<Window x:Class="Captail.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Captail"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L.Library.TrimTitle}"
        Icon="{DynamicResource ApplicationIcon}"
        Width="900" Height="790" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="{StaticResource BgWindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ReplayCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource BorderControlBrush}"
                                Background="{StaticResource BgControlBrush}">
                            <Path x:Name="Tick" Data="M3 8l4 4 7-8" Margin="1"
                                  Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EditorMergeCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Path x:Name="Check" Visibility="Collapsed"
                                      Data="M4 9l3 3 7-7" Stroke="#07110E"
                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="FocusBorder" Grid.ColumnSpan="2" Margin="-4"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="7"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerShortcutCell" TargetType="Border">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
        </Style>
        <Style x:Key="PlayerShortcutBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PlayerShortcutBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PlaybackSpeedFeedbackBadge" TargetType="Border">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentChipBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentChipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowChrome" Background="{StaticResource BgWindowGradient}"
            BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ContentColumn" Width="*"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="56"/>
                <RowDefinition x:Name="WorkspaceRow" Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="EditorHeader" Grid.ColumnSpan="2"
                  Margin="20,0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="HeaderTrimIcon" Data="{StaticResource IconScissors}"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                          Width="15" Height="15" Stretch="Uniform"/>
                    <Path x:Name="HeaderPreviewIcon" Data="{StaticResource IconPlay}"
                          Fill="{DynamicResource AccentBrush}" Width="15" Height="15"
                          Stretch="Uniform" Visibility="Collapsed"/>
                    <TextBlock x:Name="HeaderTitleText"
                               Text="{DynamicResource L.Library.TrimTitle}"
                               FontSize="14.5" FontWeight="ExtraBold" Margin="9,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ClipNameText" Grid.Column="1" Margin="14,0,14,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <Button x:Name="PlayerHelpButton" Grid.Column="2"
                        Content="{DynamicResource L.Library.Help}"
                        Style="{StaticResource SubtleButton}"
                        Height="30" MinWidth="82" Padding="13,0"
                        VerticalAlignment="Center" FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentBrush}"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentDimBrush}"
                        BorderThickness="1"
                        Click="PlayerHelp_Click"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}"
                        Click="Close_Click" ToolTip="{DynamicResource L.Close}">
                    <Path Data="M6 6l12 12 M18 6L6 18"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid x:Name="EditorWorkspace" Grid.Row="1" Grid.Column="0"
                  Margin="20,0,20,20" SizeChanged="EditorWorkspace_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PreviewRow" Height="*"/>
                    <RowDefinition x:Name="PlaybackRow" Height="Auto"/>
                    <RowDefinition x:Name="TimelineRow" Height="Auto"/>
                    <RowDefinition x:Name="ActionsRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="PreviewBorder" Background="#FF070A0C"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid x:Name="PreviewSurface"
                          PreviewMouseWheel="PreviewSurface_MouseWheel"
                          MouseLeftButtonUp="PreviewSurface_MouseLeftButtonUp">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <local:MpvHost x:Name="PreviewPlayer" Visibility="Collapsed"/>
                        <Grid x:Name="PreviewLoadingOverlay" Background="#D6070A0C"
                              Panel.ZIndex="8">
                            <Control Style="{StaticResource LoadingIndicator}"
                                     Width="34" Height="34"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="NormalPlaybackBar" Grid.Row="1" Margin="1,11,1,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PlaybackTimeText" Text="00:00 / 00:00"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel x:Name="EditorTransportControls" Grid.Column="1"
                                Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="EditorPreviousReplayButton"
                                Style="{StaticResource ClipActionButton}"
                                Click="PreviousReplay_Click"
                                ToolTip="{DynamicResource L.Library.PreviousReplay}">
                            <Path Data="{StaticResource IconSkipPrevious}"
                                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ClipActionButton}" Click="Back_Click"
                                Margin="6,0,0,0"
                                ToolTip="{DynamicResource L.Library.Back5}">
                            <Path Data="{StaticResource IconSeekBack}"
                                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource ClipActionButton}"
                                Click="PlayPause_Click" ToolTip="{DynamicResource L.Library.Play}"
                                Margin="6,0,0,0" IsEnabled="False">
                            <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ClipActionButton}" Click="Forward_Click"
                                ToolTip="{DynamicResource L.Library.Forward5}" Margin="6,0,0,0">
                            <Path Data="{StaticResource IconSeekForward}"
                                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="EditorNextReplayButton"
                                Style="{StaticResource ClipActionButton}"
                                Margin="6,0,0,0"
                                Click="NextReplay_Click"
                                ToolTip="{DynamicResource L.Library.NextReplay}">
                            <Path Data="{StaticResource IconSkipNext}"
                                  Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="EditorPlaybackOptions" Grid.Column="2"
                                Orientation="Horizontal" HorizontalAlignment="Right">
                        <Slider x:Name="EditorVolumeSlider"
                                Width="110" Margin="0,0,12,0"
                                Minimum="0" Maximum="100" TickFrequency="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource VolumeSlider}"
                                ToolTip="{DynamicResource L.Library.ShortcutVolume}"
                                ValueChanged="PlayerVolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="RangeDurationText"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="EditorFullscreenButton"
                                Style="{StaticResource ClipActionButton}"
                                Margin="10,-7,0,-7" Click="EnterFullscreen_Click"
                                ToolTip="{DynamicResource L.Library.Fullscreen}">
                            <Path Data="{StaticResource IconFullscreen}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FullscreenControlBar" Grid.Row="1"
                        Background="#FF0B0F11" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed" Opacity="0"
                        MouseMove="FullscreenControls_MouseMove">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Slider x:Name="FullscreenProgressSlider"
                                Style="{StaticResource FullscreenProgressSlider}"
                                Margin="18,0" VerticalAlignment="Center"
                                PreviewMouseLeftButtonDown="FullscreenProgress_MouseLeftButtonDown"
                                ValueChanged="FullscreenProgress_ValueChanged"
                                Thumb.DragStarted="FullscreenProgress_DragStarted"
                                Thumb.DragCompleted="FullscreenProgress_DragCompleted"/>
                        <Grid Grid.Row="1" Margin="18,1,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ClipActionButton}" Click="Back_Click"
                                        ToolTip="{DynamicResource L.Library.Back5}">
                                    <Path Data="{StaticResource IconSeekBack}"
                                          Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource ClipActionButton}"
                                        Click="PlayPause_Click" ToolTip="{DynamicResource L.Library.Play}"
                                        Margin="7,0,0,0">
                                    <Path x:Name="FullscreenPlayIcon" Data="{StaticResource IconPlay}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource ClipActionButton}" Click="Forward_Click"
                                        ToolTip="{DynamicResource L.Library.Forward5}" Margin="7,0,0,0">
                                    <Path Data="{StaticResource IconSeekForward}"
                                          Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="FullscreenPlaybackTimeText"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontMono}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border x:Name="FullscreenSpeedFeedback"
                                        Style="{StaticResource PlaybackSpeedFeedbackBadge}"
                                        Visibility="Collapsed" Opacity="0">
                                    <TextBlock x:Name="FullscreenSpeedFeedbackText"
                                               Style="{StaticResource PlayerShortcutBadgeText}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource ClipActionButton}"
                                    Click="ExitFullscreen_Click"
                                    ToolTip="{DynamicResource L.Library.ExitFullscreen}">
                                <Path Data="{StaticResource IconExitFullscreen}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel x:Name="TimelineEditorPanel" Grid.Row="2">
                    <TextBlock Text="{DynamicResource L.Library.VideoTrack}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,6"/>
                    <Grid x:Name="RangeTimeline" Height="76" ClipToBounds="False"
                          SizeChanged="RangeTimeline_SizeChanged"
                          MouseLeftButtonDown="RangeTimeline_MouseLeftButtonDown">
                        <Border Background="{StaticResource BgControlBrush}" CornerRadius="8"
                                ClipToBounds="True">
                            <ItemsControl x:Name="TimelineFrames" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Canvas x:Name="RangeOverlay" Background="Transparent">
                            <Rectangle x:Name="LeftShade" Height="76" Fill="#C4070A0C"/>
                            <Rectangle x:Name="RightShade" Height="76" Fill="#C4070A0C"/>
                            <Border x:Name="SelectionBorder" Height="76"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3"
                                    CornerRadius="8" IsHitTestVisible="False"/>
                            <Thumb x:Name="StartThumb" Width="16" Height="76" Cursor="SizeWE"
                                   Panel.ZIndex="4" DragDelta="StartThumb_DragDelta"
                                   DragCompleted="RangeThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8,2,2,8">
                                            <Rectangle Width="2" Height="22" RadiusX="1" RadiusY="1"
                                                       Fill="{DynamicResource OnAccentBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="EndThumb" Width="16" Height="76" Cursor="SizeWE"
                                   Panel.ZIndex="4" DragDelta="EndThumb_DragDelta"
                                   DragCompleted="RangeThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2,8,8,2">
                                            <Rectangle Width="2" Height="22" RadiusX="1" RadiusY="1"
                                                       Fill="{DynamicResource OnAccentBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PlayheadThumb" Width="13" Height="88" Cursor="Hand"
                                   Canvas.Top="-6" Panel.ZIndex="5"
                                   DragStarted="PlayheadThumb_DragStarted"
                                   DragDelta="PlayheadThumb_DragDelta"
                                   DragCompleted="PlayheadThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Rectangle Width="2" Fill="#FFF1F6F4" RadiusX="1" RadiusY="1"/>
                                            <Ellipse Width="9" Height="9" Fill="#FFF1F6F4"
                                                     VerticalAlignment="Top"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Canvas>
                    </Grid>

                    <Grid Margin="1,7,1,3">
                        <TextBlock x:Name="StartTimeText" Text="00:00.000"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5"/>
                        <TextBlock x:Name="EndTimeText" Text="00:00.000"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="2,5,2,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource L.Library.AudioTracks}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="AudioTrackCountBadge" Margin="7,0,0,0"
                                    MinWidth="24" Height="18" Padding="6,0"
                                    Background="{DynamicResource AccentChipBgBrush}"
                                    BorderBrush="{DynamicResource AccentChipBorderBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="AudioTrackCountText" Text="0"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource L.Library.AudioTrackHint}"
                                   HorizontalAlignment="Right" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <ScrollViewer x:Name="AudioTrackScrollViewer" Height="96" MaxHeight="288"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="AudioTrackRows" ItemsSource="{Binding AudioTracks}"
                                      Margin="0,0,4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="42" Margin="0,0,0,6">
                                        <Border Background="#FF101518" BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Waveform}" Stretch="Fill" Opacity="0.66"/>
                                                <Border Background="#5A101518"/>
                                            </Grid>
                                        </Border>
                                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Tag="{Binding}" Click="AudioTrackToggle_Click"
                                                      Style="{StaticResource SourceChip}"
                                                      HorizontalAlignment="Left" Width="190" Height="34"
                                                      Margin="4,0,0,0" VerticalAlignment="Center">
                                            <Grid Width="164">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="116" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Codec}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" FontSize="9.5"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Grid>
                                        </ToggleButton>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoAudioText" Text="{DynamicResource L.Library.NoAudio}"
                               Style="{StaticResource SecondaryText}" Margin="2,4,0,7"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="EditorActionsPanel" Grid.Row="3" Margin="0,9,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="EditorStatusPanel" Grid.Column="0"
                                Margin="2,0,14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EditorStatusText" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Left" TextAlignment="Left"
                                   TextTrimming="CharacterEllipsis" FontSize="10"/>
                        <TextBlock x:Name="ClipInfoText" HorizontalAlignment="Left"
                                   TextAlignment="Left" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="EditorActionButtons" Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right" ClipToBounds="False">
                        <Button x:Name="OutputSettingsButton"
                                Style="{StaticResource ClipActionButton}"
                                Margin="0,0,8,0" Click="OutputSettings_Click"
                                IsEnabled="False"
                                ToolTip="{DynamicResource L.Library.OutputSettings}">
                            <Path Data="{StaticResource IconGear}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="17" Height="17" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="CancelButton"
                                Content="{DynamicResource L.Library.Cancel}" Style="{StaticResource SubtleButton}"
                                Padding="16,9" Click="Close_Click"/>
                        <Button x:Name="OverwriteButton" Margin="8,0,0,0"
                                Content="{DynamicResource L.Library.Overwrite}"
