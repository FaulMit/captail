<Window x:Class="Captail.ClipEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Captail"
        Title="{DynamicResource L.Library.TrimTitle}"
        Icon="Assets/Captail.ico"
        Width="900" Height="790"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False" Background="{StaticResource BgWindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="EditorMergeCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource BgControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderControlBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Path x:Name="Check" Visibility="Collapsed"
                                      Data="M4 9l3 3 7-7" Stroke="#07110E"
                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                            <Border x:Name="FocusBorder" Grid.ColumnSpan="2" Margin="-4"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="7"
                                    Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource TextMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowChrome" Background="{StaticResource BgWindowGradient}"
            BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="56"/>
                <RowDefinition x:Name="WorkspaceRow" Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="EditorHeader" Margin="20,0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconScissors}" Stroke="{StaticResource AccentBrush}"
                          StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform"/>
                    <TextBlock Text="{DynamicResource L.Library.TrimTitle}"
                               FontSize="14.5" FontWeight="ExtraBold" Margin="9,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ClipNameText" Grid.Column="1" Margin="14,0,14,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        Click="Close_Click" ToolTip="{DynamicResource L.Close}">
                    <Path Data="M6 6l12 12 M18 6L6 18"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
            </Grid>

            <Grid x:Name="EditorWorkspace" Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PreviewRow" Height="390"/>
                    <RowDefinition x:Name="PlaybackRow" Height="Auto"/>
                    <RowDefinition x:Name="TimelineRow" Height="*"/>
                    <RowDefinition x:Name="ActionsRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="PreviewBorder" Background="#FF070A0C"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid x:Name="PreviewSurface">
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <local:MpvHost x:Name="PreviewPlayer" Visibility="Collapsed"/>
                        <Grid x:Name="PreviewLoadingOverlay" Background="#D6070A0C"
                              Panel.ZIndex="8">
                            <Control Style="{StaticResource LoadingIndicator}"
                                     Width="34" Height="34"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid x:Name="NormalPlaybackBar" Grid.Row="1" Margin="1,11,1,8">
                    <TextBlock x:Name="PlaybackTimeText" Text="00:00 / 00:00"
                               FontFamily="{StaticResource FontMono}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="RangeDurationText"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ClipActionButton}"
                                Margin="10,-7,0,-7" Click="EnterFullscreen_Click"
                                ToolTip="{DynamicResource L.Library.Fullscreen}">
                            <Path Data="{StaticResource IconFullscreen}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FullscreenControlBar" Grid.Row="1"
                        Background="#FF0B0F11" BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed" Opacity="0"
                        MouseMove="FullscreenControls_MouseMove">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Slider x:Name="FullscreenProgressSlider"
                                Style="{StaticResource FullscreenProgressSlider}"
                                Margin="18,0" VerticalAlignment="Center"
                                PreviewMouseLeftButtonDown="FullscreenProgress_MouseLeftButtonDown"
                                ValueChanged="FullscreenProgress_ValueChanged"
                                Thumb.DragStarted="FullscreenProgress_DragStarted"
                                Thumb.DragCompleted="FullscreenProgress_DragCompleted"/>
                        <Grid Grid.Row="1" Margin="18,1,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ClipActionButton}" Click="Back_Click"
                                        ToolTip="{DynamicResource L.Library.Back5}">
                                    <Path Data="M15 5L8 12l7 7 M8 12h10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource ClipActionButton}"
                                        Click="PlayPause_Click" ToolTip="{DynamicResource L.Library.Play}"
                                        Margin="7,0,0,0">
                                    <Path x:Name="FullscreenPlayIcon" Data="{StaticResource IconPlay}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource ClipActionButton}" Click="Forward_Click"
                                        ToolTip="{DynamicResource L.Library.Forward5}" Margin="7,0,0,0">
                                    <Path Data="M9 5l7 7-7 7 M6 12h10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="FullscreenPlaybackTimeText" Grid.Column="1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontMono}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Grid.Column="2" Style="{StaticResource ClipActionButton}"
                                    Click="ExitFullscreen_Click"
                                    ToolTip="{DynamicResource L.Library.ExitFullscreen}">
                                <Path Data="{StaticResource IconExitFullscreen}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{DynamicResource L.Library.VideoTrack}"
                               FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,6"/>
                    <Grid x:Name="RangeTimeline" Height="76" ClipToBounds="False"
                          SizeChanged="RangeTimeline_SizeChanged"
                          MouseLeftButtonDown="RangeTimeline_MouseLeftButtonDown">
                        <Border Background="{StaticResource BgControlBrush}" CornerRadius="8"
                                ClipToBounds="True">
                            <ItemsControl x:Name="TimelineFrames" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Canvas x:Name="RangeOverlay" Background="Transparent">
                            <Rectangle x:Name="LeftShade" Height="76" Fill="#C4070A0C"/>
                            <Rectangle x:Name="RightShade" Height="76" Fill="#C4070A0C"/>
                            <Border x:Name="SelectionBorder" Height="76"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
                                    CornerRadius="8" IsHitTestVisible="False"/>
                            <Thumb x:Name="StartThumb" Width="16" Height="76" Cursor="SizeWE"
                                   Panel.ZIndex="4" DragDelta="StartThumb_DragDelta"
                                   DragCompleted="RangeThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="8,2,2,8">
                                            <Rectangle Width="2" Height="22" RadiusX="1" RadiusY="1"
                                                       Fill="{StaticResource OnAccentBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="EndThumb" Width="16" Height="76" Cursor="SizeWE"
                                   Panel.ZIndex="4" DragDelta="EndThumb_DragDelta"
                                   DragCompleted="RangeThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="2,8,8,2">
                                            <Rectangle Width="2" Height="22" RadiusX="1" RadiusY="1"
                                                       Fill="{StaticResource OnAccentBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PlayheadThumb" Width="13" Height="88" Cursor="Hand"
                                   Canvas.Top="-6" Panel.ZIndex="5"
                                   DragStarted="PlayheadThumb_DragStarted"
                                   DragDelta="PlayheadThumb_DragDelta"
                                   DragCompleted="PlayheadThumb_DragCompleted">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Rectangle Width="2" Fill="#FFF1F6F4" RadiusX="1" RadiusY="1"/>
                                            <Ellipse Width="9" Height="9" Fill="#FFF1F6F4"
                                                     VerticalAlignment="Top"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Canvas>
                    </Grid>

                    <Grid Margin="1,7,1,3">
                        <TextBlock x:Name="StartTimeText" Text="00:00.000"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5"/>
                        <TextBlock x:Name="EndTimeText" Text="00:00.000"
                                   FontFamily="{StaticResource FontMono}" FontSize="11.5"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="2,5,2,5">
                        <TextBlock Text="{DynamicResource L.Library.AudioTracks}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{DynamicResource L.Library.AudioTrackHint}"
                                   HorizontalAlignment="Right" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                    <ItemsControl x:Name="AudioTrackRows" ItemsSource="{Binding AudioTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" Margin="0,0,0,6">
                                    <Border Background="#FF101518" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Waveform}" Stretch="Fill" Opacity="0.66"/>
                                            <Border Background="#5A101518"/>
                                        </Grid>
                                    </Border>
                                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Tag="{Binding}" Click="AudioTrackToggle_Click"
                                                  Style="{StaticResource SourceChip}"
                                                  HorizontalAlignment="Left" Width="190" Height="34"
                                                  Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Grid Width="164">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="116" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Codec}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="9.5"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Grid>
                                    </ToggleButton>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoAudioText" Text="{DynamicResource L.Library.NoAudio}"
                               Style="{StaticResource SecondaryText}" Margin="2,4,0,7"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource ClipActionButton}" Click="Back_Click"
                                ToolTip="{DynamicResource L.Library.Back5}">
                            <Path Data="M15 5L8 12l7 7 M8 12h10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource ClipActionButton}"
                                Click="PlayPause_Click" ToolTip="{DynamicResource L.Library.Play}"
                                Margin="6,0,0,0" IsEnabled="False">
                            <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ClipActionButton}" Click="Forward_Click"
                                ToolTip="{DynamicResource L.Library.Forward5}" Margin="6,0,0,0">
                            <Path Data="M9 5l7 7-7 7 M6 12h10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EditorStatusText" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Right" TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="340" FontSize="10"/>
                        <TextBlock x:Name="ClipInfoText" HorizontalAlignment="Right"
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                   MaxWidth="340" FontFamily="{StaticResource FontMono}"
                                   FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource L.Library.Cancel}" Style="{StaticResource SubtleButton}"
                                Padding="16,9" Click="Close_Click"/>
                        <Button x:Name="OverwriteButton" Margin="8,0,0,0"
                                Content="{DynamicResource L.Library.Overwrite}"
                                Style="{StaticResource SubtleButton}" Padding="16,9"
                                Click="RequestOverwrite_Click"/>
                        <CheckBox x:Name="MergeAudioCheckBox" Margin="12,0,3,0"
                                  Style="{StaticResource EditorMergeCheckBox}"
                                  Visibility="Collapsed"
                                  ToolTip="{DynamicResource L.Library.MergeAudioTip}"
                                  ToolTipService.ShowOnDisabled="True">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.Library.MergeAudio}"
                                           FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource L.Library.MergeAudioSummary}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </CheckBox>
                        <Button x:Name="SaveTrimButton" Margin="8,0,0,0"
                                Content="{DynamicResource L.Library.SaveTrim}"
                                Style="{StaticResource AccentButton}" Padding="18,9"
                                Click="SaveTrim_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="OverwriteConfirmOverlay" Grid.RowSpan="2" Panel.ZIndex="30"
                    Visibility="Collapsed" Background="#C20A0D0F"
                    CornerRadius="{StaticResource RadiusWindow}">
                <Border Width="370" Padding="20" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.Library.OverwriteTitle}"
                                   FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="OverwriteMessageText"
                                   Text="{DynamicResource L.Library.OverwriteMessage}"
                                   Margin="0,9,0,0" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverwriteFileText" Margin="0,9,0,18"
                                   Style="{StaticResource MonoText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource L.Library.Cancel}"
                                    Style="{StaticResource SubtleButton}"
                                    Margin="0,0,8,0" Click="CancelOverwrite_Click"/>
                            <Button Content="{DynamicResource L.Library.Overwrite}"
                                    Style="{StaticResource AccentButton}" Padding="16,8"
                                    Click="ConfirmOverwrite_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <Grid x:Name="SavingOverlay" Grid.RowSpan="2" Panel.ZIndex="40"
                  Visibility="Collapsed"
                  TextOptions.TextRenderingMode="Grayscale"
                  TextOptions.TextFormattingMode="Display">
                <Border x:Name="SavingBackdrop" Opacity="0"
                        Background="#DC0A0D0F"
                        CornerRadius="{StaticResource RadiusWindow}"/>
                <StackPanel Width="260" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Control Style="{StaticResource LoadingIndicator}"
                             Width="36" Height="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource L.Library.SavingTitle}"
                               Margin="0,16,0,0" FontSize="15" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="SavingStatusText" Margin="0,7,0,0"
                               Style="{StaticResource SecondaryText}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
