<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>..\..\src\Captail\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Captail\Captail.csproj" />
    <Resource Include="..\..\src\Captail\Assets\*.ico" Link="Assets\%(Filename)%(Extension)" />
    <Page Include="..\..\src\Captail\Languages\Strings.*.xaml" Link="Languages\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
